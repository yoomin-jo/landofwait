[Unit]
Description=슬리브별 평가액 일일 기록 + 월간 성과 리포트
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/hybrid-portfolio
ExecStart=/home/pi/hybrid-portfolio/venv/bin/python performance.py
EnvironmentFile=/home/pi/hybrid-portfolio/.env

[Install]
WantedBy=multi-user.target
