[Unit]
Description=자산배분 봇 하루 1회 생존 신호 (텔레그램 상태 요약)
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/hybrid-portfolio
ExecStart=/home/pi/hybrid-portfolio/venv/bin/python heartbeat.py
EnvironmentFile=/home/pi/hybrid-portfolio/.env

[Install]
WantedBy=multi-user.target
